# Dakota Language Extraction - Environment Variables Template
# Copy this file to .env and fill in your actual API keys

# ============================================================================
# PRIMARY API KEYS (Required for extraction)
# ============================================================================

# Anthropic Claude API - Primary extraction method (recommended)
# Get your key from: https://console.anthropic.com/
# Used by: test_dakota_claude.py, extract_20_pages.py, ClaudePageProcessor
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenRouter API - Alternative extraction method with Qwen3-VL
# Get your key from: https://openrouter.ai/keys
# Used by: extract_dakota_dictionary_v2.py, PageProcessor, AdvancedPageProcessor
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Thinking Machines / Tinker API - remote RL training and sampler inference
# Get your key from: Thinking Machines console (Tinker)
# Used by: dakota_rl_training/tinker_train.py, run_inference.py
TINKER_API_KEY=your_tinker_api_key_here

# ============================================================================
# OPTIONAL API KEYS
# ============================================================================

# E2B Sandbox - For experimental self-hosted model deployment
# Get your key from: https://e2b.dev/
# Used by: e2b/e2b_connector.py, e2b/main.py
E2B_API_KEY=your_e2b_api_key_here

# Hugging Face - For model publishing and dedicated endpoint inference
# Get your token from: https://huggingface.co/settings/tokens
# Used by: hf_inference_standalone.py, publishing flows, E2B sandbox setup
HF_TOKEN=your_huggingface_token_here

# OpenAI - For the Dakota SFT baseline launcher
# Used by: scripts/rl/dakota_openai_finetune.py
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# MODEL CONFIGURATION (Optional - uses defaults if not set)
# ============================================================================

# Qwen3-VL Model Configuration
# Default model ID for Qwen3-VL (usually don't need to change)
# QWEN_VL_MODEL_ID=Qwen/Qwen3-VL-235B-A22B-Thinking

# OpenRouter model slug for Qwen3-VL
# QWEN_OPENROUTER_MODEL_ID=qwen/qwen3-vl-235b-a22b-thinking

# Claude Model Configuration
# Default Claude model (usually don't need to change)
# CLAUDE_MODEL_ID=claude-sonnet-4-5-20250929

# OpenAI SFT baseline model configuration
# Current supported supervised fine-tuning snapshots in this repo:
# - gpt-4.1-2025-04-14
# - gpt-4.1-mini-2025-04-14
# - gpt-4.1-nano-2025-04-14
# Default baseline uses the strongest current GPT-4.1 SFT snapshot.
# Use gpt-4.1-mini-2025-04-14 for a lower-cost baseline.
# OPENAI_FINETUNE_MODEL=gpt-4.1-2025-04-14
# OPENAI_FINETUNE_EPOCHS=3

# ============================================================================
# REASONING BUDGET CONFIGURATION (Optional)
# ============================================================================

# OpenRouter reasoning token budget
# Higher values = more thorough analysis but slower and more expensive
# Recommended: 4096-8000 for dictionary extraction
# OPENROUTER_REASONING_MAX_TOKENS=6000

# Include reasoning traces in output (true/false)
# OPENROUTER_INCLUDE_REASONING=true

# Reasoning effort level (low/medium/high)
# Alternative to max_tokens - use one or the other, not both
# OPENROUTER_REASONING_EFFORT=high

# ============================================================================
# APPLICATION METADATA (Optional)
# ============================================================================

# OpenRouter application metadata (helps with API usage tracking)
# OPENROUTER_SITE_URL=https://github.com/HarleyCoops/Dakota1890
# OPENROUTER_APP_NAME=Dakota Language Extraction

# ============================================================================
# NOTES
# ============================================================================

# Quick Start:
# 1. Copy this file: cp .env.template .env
# 2. Add your ANTHROPIC_API_KEY (required for primary method)
# 3. Add your OPENROUTER_API_KEY (optional, for alternative method)
# 4. Run test extraction: python test_dakota_claude.py
# 5. Run remote Tinker inference: python run_inference.py --prompt "Translate 'my elder brother' to Dakota. Return only the answer."

# Cost Estimates:
# - Claude Sonnet 4.5: ~$0.25 per dictionary page
# - Full extraction (352 pages): ~$88
# - Test single page: ~$0.03

# Which API key do I need?
# - For test_dakota_claude.py: ANTHROPIC_API_KEY
# - For extract_dakota_dictionary_v2.py: OPENROUTER_API_KEY
# - For run_inference.py: TINKER_API_KEY
# - For hf_inference_standalone.py: HF_TOKEN plus a configured HF endpoint
# - For best results: Use ANTHROPIC_API_KEY (Claude Sonnet 4.5)
